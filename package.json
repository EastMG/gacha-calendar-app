{
  "name": "gacha-calendar-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "二游卡池/活动日历 App（Android / iOS / HarmonyOS）—— 可验证的共享核心层 + 浏览器预览",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EastMG/gacha-calendar-app.git"
  },
  "homepage": "https://github.com/EastMG/gacha-calendar-app",
  "bugs": {
    "url": "https://github.com/EastMG/gacha-calendar-app/issues"
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node tools/preview-server.mjs",
    "dev:dist": "node tools/preview-server.mjs --dist",
    "build": "node tools/build-pwa.mjs",
    "data:refresh": "node tools/refresh-data.mjs",
    "icons": "python tools/make-icons.py",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none",
    "check": "npm run typecheck && npm run build && npm run test"
  },
  "dependencies": {
    "gacha-calendar-core": "0.12.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
